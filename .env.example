# ============================================================
# VeriTix Web – Frontend Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.
#
# Legend:
#   REQUIRED  – must be set for a healthy local build/startup
#   OPTIONAL  – can be left blank for local development
# ============================================================

# ----- Backend API -----
# Type: string | required
# Required: yes
# Example: https://api.veritix.io
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# WebSocket server URL for real-time features
# Type: string | optional
# Required: no
# Example: ws://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# ----- Stellar / Blockchain -----
# Type: string | required
# Required: yes
# Example: testnet
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Horizon server URL (leave blank to use the SDK default for the chosen network)
# Type: string | optional
# Required: no
# Example: https://horizon-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=

# Stellar account public key for the platform escrow (server-only)
# Type: string | optional
# Required: no
# Example: GABC123...
STELLAR_PLATFORM_PUBLIC_KEY=

# Stellar account secret key (server-only — NEVER prefix with NEXT_PUBLIC_)
# Type: string | optional
# Required: no
# Example: SABC123...
STELLAR_PLATFORM_SECRET_KEY=

# ----- Authentication -----
# Secret used to sign/verify server-side session tokens (server-only)
# Type: string | required
# Required: yes
# Example: replace-with-a-long-random-string
AUTH_SECRET=replace-with-a-long-random-string

# NextAuth / session configuration
# Type: string | optional
# Required: no
# Example: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Type: string | optional
# Required: no
# Example: replace-with-a-long-random-string
NEXTAUTH_SECRET=replace-with-a-long-random-string

# ----- OAuth Providers (server-only) -----
# Type: string | optional
# Required: no
# Example: your-google-client-id
GOOGLE_CLIENT_ID=

# Type: string | optional
# Required: no
# Example: your-google-client-secret
GOOGLE_CLIENT_SECRET=

# ----- Feature Flags -----
# Type: boolean | optional
# Required: no
# Example: false
NEXT_PUBLIC_ENABLE_WALLET_CONNECT=false

# Type: boolean | optional
# Required: no
# Example: false
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Type: boolean | optional
# Required: no
# Example: false
NEXT_PUBLIC_WALLET_AUTH_ENABLED=false

# ----- Analytics / Monitoring -----
# Type: string | optional
# Required: no
# Example: https://example@sentry.io/123
NEXT_PUBLIC_SENTRY_DSN=

# Type: string | optional
# Required: no
# Example: your-sentry-auth-token
SENTRY_AUTH_TOKEN=

# ----- Analytics (optional) -----
# Type: string | optional
# Required: no
# Example: your-analytics-token
NEXT_PUBLIC_ANALYTICS_TOKEN=

# ----- Bundle Analysis -----
# Type: boolean | optional
# Required: no
# Example: false
ANALYZE=false