# ============================================================
# VeriTix Web – Environment Variables
# ============================================================
# Copy this file to .env.local and adjust the values.
# Never commit .env.local to version control.
#
# This file lists the variables the code actually reads. Everything is optional
# for a local `npm run dev`: each entry says what happens when it is unset.
# Entries are commented out where leaving them unset is the safe default;
# uncomment and fill in only the ones you need. Do not leave a variable set to an
# empty value: an empty string is not the same as unset (the URL checks in
# src/lib/env.ts reject it instead of applying the default).
# Variables set by tooling (NODE_ENV, CI, NEXT_RUNTIME) are not listed.
#
# Only NEXT_PUBLIC_* values are exposed to the browser. Do not put a secret in a
# NEXT_PUBLIC_* variable.
# ============================================================

# ----- Backend API -----
# Three names currently point at the backend, and the code reads them in
# different places. Set the ones for the features you use until they are
# consolidated into one.

# Base URL for requests made by the browser client (src/lib/api-client.ts,
# validated in src/lib/env.ts). Must be a valid URL.
# Unset: http://localhost:3000/api
# NEXT_PUBLIC_API_URL=

# Base URL for the server-side helpers and the orders route
# (src/lib/api/server.ts, src/app/api/orders/route.ts). Takes precedence over
# NEXT_PUBLIC_API_URL there.
# Unset: falls back to NEXT_PUBLIC_API_URL, then to an empty string (relative URLs).
# NEXT_PUBLIC_API_BASE_URL=

# Backend base URL for the tickets route (src/app/api/tickets/route.ts). Server-only.
# Unset: the route requests "undefined/tickets" and the backend call fails, so
# set it if you use /api/tickets.
# Example: http://localhost:4000/api
# API_BASE_URL=

# ----- App -----
# Canonical public URL of the app, used for page metadata. Must be a valid URL.
# Unset: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----- Stellar -----
# Network the checkout expects the wallet to be on: "testnet" or "mainnet".
# Any other value fails at startup.
# Unset: testnet
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# ----- Ticket verification (server-only) -----
# HMAC secret for signing ticket QR payloads, 16+ characters. Rotating it
# invalidates every issued QR code.
# Unset: falls back to JWT_SECRET. If neither is set, /api/verify refuses every
# scan with a 503.
# TICKET_SIGNING_SECRET=

# Used only as the fallback for TICKET_SIGNING_SECRET (src/lib/ticket-signing.ts).
# Unset: no fallback.
# JWT_SECRET=

# ----- Blog -----
# Set to 1 to include draft posts in the blog index and let them render.
# Unset (or anything else): drafts are hidden and their pages return 404.
# BLOG_INCLUDE_DRAFTS=

# ----- Error monitoring (Sentry) -----
# Browser and server DSN. Reporting is enabled only in production builds, and
# only when this is set.
# Unset: Sentry is off.
# NEXT_PUBLIC_SENTRY_DSN=

# Enables source-map upload at build time. Read by next.config.js to decide
# whether the build output is quiet, and by Sentry's build plugin.
# Unset: no upload, and the build stays quiet about it.
# SENTRY_AUTH_TOKEN=

# Read by Sentry's build plugin (not by app code); needed together with
# SENTRY_AUTH_TOKEN for source-map upload.
# Unset: no upload.
# SENTRY_ORG=
# SENTRY_PROJECT=

# Deployment label sent to Sentry. Vercel sets it ("production", "preview", ...).
# Unset: NODE_ENV is used.
# VERCEL_ENV=

# ----- Build options -----
# Set to true to write the bundle analyzer report during `next build`.
# BUNDLE_ANALYZE=true does the same. The report does not open a browser when CI=true.
# Unset: off.
# ANALYZE=

# Set to true on a production build to emit a service worker (npm run build:pwa).
# Unset: no service worker, and Turbopack stays enabled.
# ENABLE_PWA=

# ----- End-to-end tests (Playwright) -----
# Port the test web server listens on. E2E_PORT wins over PORT.
# Unset: 3000
# E2E_PORT=
# PORT=

# Set to "build" to test a production build (npm run build, then start) instead
# of the dev server.
# Unset: the dev server is used.
# E2E_WEB_SERVER=
